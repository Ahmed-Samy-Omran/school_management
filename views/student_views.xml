<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Student List View -->
    <record id="view_school_student_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Students" default_order="admission_number">
                <field name="admission_number" />
                <field name="name" />
                <field name="date_of_birth" />
                <field name="age" />
                <field name="gender" />
                <field name="email" />
                <field name="phone" />
            </list>
        </field>
    </record>

    <!-- Student Form View -->
    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Students">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Student Name" />
                        </h1>
                    </div>

                    <group>
                        <group string="Student Information">
                            <field name="admission_number" />
                            <field name="date_of_birth" />
                            <field name="age" readonly="1" />
                            <field name="gender" />
                        </group>

                        <group string="Contact Information">
                            <field name="email" />
                            <field name="phone" />
                        </group>
                    </group>

                    <field name="active" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Student Search View -->
  
    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search string="Students">
                <field name="name" />
                <field name="admission_number" />
                <field name="email" />
                <separator />

                <filter
                    name="filter_active"
                    string="Active Students"
                    domain="[('active', '=', True)]"
                />

                <filter
                    name="filter_archived"
                    string="Archived Students"
                    domain="[('active', '=', False)]"
                />

                <group>
                    <filter
                        name="group_by_gender"
                        string="Gender"
                        context="{'group_by': 'gender'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Student Window Action -->
    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_student_search" />
    </record>

    <!-- Application Menu -->
    <menuitem
        id="menu_school_root"
        name="School Management"
        sequence="10"
    />

    <menuitem
        id="menu_school_student"
        name="Students"
        parent="menu_school_root"
        action="action_school_student"
        sequence="10"
    />

</odoo>