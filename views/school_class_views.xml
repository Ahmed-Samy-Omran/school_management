<odoo>
    <!-- Class List -->
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list string="Grades" default_order="sequence, name">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="section_count" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Class Form -->
    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="School Grade">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Grade Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>

                        <group>
                            <field name="section_count" readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Sections">
                            <field name="section_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="academic_year_id" />
                                    <field name="class_teacher_id" />
                                    <field name="capacity" />
                                    <field name="student_count" />
                                </list>
                            </field>
                        </page>

                        <page string="Description">
                            <field name="description" />
                        </page>

                    </notebook>


                </sheet>
            </form>
        </field>
    </record>
    <!-- Class Search -->
    <record id="view_school_class_search" model="ir.ui.view">
        <field name="name">school.class.search</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <search string="Search Grades">
                <field name="name" />
                <field name="code" />
                <field name="active" />
                <filter name="active_grades"
                    string="Active Grades"
                    domain="[('active', '=', True)]"
                />

                <filter name="archived_grades"
                    string="Archived Grades"
                    domain="[('active', '=', False)]"
                />

                <filter name="group_by_active" string="Active" context="{'group_by': 'active'}" />
            </search>
        </field>
    </record>

    <!-- Class Action -->
    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_school_class"
        name="Grades"
        parent="menu_school_root"
        action="action_school_class"
        sequence="40"
    />

</odoo>